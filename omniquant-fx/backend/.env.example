# ==========================================
# OMNIQUANT FX - Backend Configuration
# ==========================================

# Database: Local SQLite fallback by default, switch to TimescaleDB/Postgres on VPS
DATABASE_URL=sqlite:///./omniquant_fx.db
# DATABASE_URL=postgresql+psycopg2://quant:quant_secret_2026@timescaledb:5432/omniquant_fx

# Price Feed Provider: auto | twelvedata | oanda | dukascopy | simulator
PRICE_PROVIDER=auto

# Optional API Keys (auto-fallbacks to Quant Institutional Simulator if empty)
TWELVEDATA_API_KEY=
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Economic Calendar API (auto-fallbacks to ForexFactory / Institutional Macro Schedule)
FMP_API_KEY=
NEWS_SHIELD_MINUTES=30

# Background Signal Update Cron Interval (seconds)
CRON_INTERVAL_SECONDS=60
